---
const { title, url, image } = Astro.props
---
<li class="guide-card">
  <a href={url}>
    {image && <img src={image.url} alt={image.alt || title} class="guide-image" />}
    <span class="guide-title">{title}</span>
  </a>
</li>

<style>
  .guide-card {
    list-style: none;
    border: 1px solid #333;
    border-radius: 8px;
    overflow: hidden;
    background: #1a1a1a;
  }

  .guide-card a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #fff;
  }

  .guide-image {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .guide-title {
    padding: 12px;
    font-weight: bold;
    text-align: center;
  }
</style>
