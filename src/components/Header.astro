---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
---
<header>
    <nav>
        <div class="logo-group">
            <a href="/" class="logo">
                <img src="/Icons/Theca-Icon.svg" width="100" height="100" alt="My Logo" />
            </a>
            <Menu />
        </div>
        <Navigation />
    </nav>
</header>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
  }
  
  .logo-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 1rem;
  }

  .logo img {
    height: 4rem;  
    width: auto;
    display: block;
  }

  div {
    display: flex;
    justify-content: space-between;
  }
</style>
