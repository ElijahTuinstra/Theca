---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const pageTitle = "About Theca";
---
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<title>{pageTitle}</title>

</head>
<BaseLayout pageTitle={pageTitle}>
<h2>What is Theca?</h2>
<p>Theca is a website meant to (theoretically) replace/supplement the Hack Club Guides Page.</p>
<h2>Who is Theca for?</h2>
<p>Theca was created to help people in <a href="https://hackclub.com/">hack club</a>, however anyone can use it!</p>
</BaseLayout>