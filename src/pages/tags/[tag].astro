---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisplayBlock from '../../components/GuideDisplayBlock.astro';

export async function getStaticPaths() {
  const allGuides = Object.values(import.meta.glob('../guides/*.md', { eager: true }));

  const uniqueTags = [...new Set(allGuides.map((guide: any) => guide.frontmatter.tags).flat())];

  return uniqueTags.map((tag) => {
    const filteredGuides = allGuides.filter((guide: any) => guide.frontmatter.tags.includes(tag));
    return {
      params: { tag },
      props: { guides: filteredGuides },
    };
  });
}

const { tag } = Astro.params;
const { guides } = Astro.props;
---
<BaseLayout pageTitle={tag}>
  <p>Guides tagged with {tag}</p>
  <ul class="guides-grid">
    {guides.map((guide: any) => (
      <DisplayBlock 
        url={guide.url} 
        title={guide.frontmatter.title}
        image={guide.frontmatter.image} 
      />
    ))}
  </ul>
</BaseLayout>

<style>
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
    list-style: none;
    padding: 0;
  }
</style>