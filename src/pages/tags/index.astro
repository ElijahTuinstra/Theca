---
import BaseLayout from '../../layouts/BaseLayout.astro'
const allGuides = Object.values(import.meta.glob('../guides/*.md', { eager: true })); /*eager part makes it get all of the needed files right away, at the same time*/
const tags = [...new Set(allGuides.map((guide: any) => guide.frontmatter.tags).flat())];
import '../../styles/global.css'

const pageTitle = "Tags";
---


<BaseLayout pageTitle={pageTitle}>
  <ul class="tags-flex">
    {tags.map((tag: string) => (
      <li class="tag-card">
        <a href={`/tags/${tag}`}>
          <span class="tag-title">{tag}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style> /*-- mostly just copied code from guideDisplayBlocks tbh */
  .tags-flex {
    display: flex; /*unlike in the page that displays all guides, this one will wrap around text*/
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
    padding: 0;
  }

  .tag-card {
    list-style: none;
    border: 1px solid #333;
    border-radius: 8px;
    overflow: hidden;
    background: #1a1a1a;
  }

  .tag-card a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #fff;
  }

  .tag-title {
    padding: 10px 20px;
    font-weight: bold;
    text-align: center;
  }
</style>
